# Compose interpolation only. Copy to deploy/.env (ignored); never commit real secrets.
# Pass --env-file deploy/.env to docker compose, or export these in your shell.
POSTGRES_PASSWORD=replace-with-a-unique-password
PUBLIC_API_URL=http://localhost:8005

# Set true and rebuild API/worker images to use RAG_PARSER=marker.
INSTALL_OCR=false

# Local DB-only setup can use backend/.env. For the full container stack,
# create backend/.env.compose and change this to ../backend/.env.compose.
BACKEND_ENV_FILE=../backend/.env
