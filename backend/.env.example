# Copy to backend/.env; run commands from backend/. Never commit real credentials.
RAG_DATABASE_URL=postgresql+asyncpg://rag:change-me@localhost:5544/rag
# Generate a token with: openssl rand -hex 32
# Keep credentials on ONE line as valid JSON, with no trailing commas.
# Example: [{"token":"<generated-token>","subject":"alice","companies":["共立電機製作所"],"admin":true}]
RAG_CREDENTIALS=[]
RAG_CORS_ORIGINS=["http://localhost:3000"]
RAG_STORAGE_DIR=storage
RAG_MODEL_BACKEND=local
RAG_DEVICE=cpu
RAG_EMBED_MODEL=cl-nagoya/ruri-v3-310m
# Immutable model revisions; validate quality on your approved corpus.
RAG_EMBED_REVISION=18b60fb8c2b9df296fb4212bb7d23ef94e579cd3
RAG_ENABLE_RERANK=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_OLLAMA_URL=http://localhost:11434
RAG_ANSWER_MODEL=qwen3:30b
RAG_ENABLE_SUMMARY=true
RAG_SUMMARY_MODEL=qcwind/qwen2.5-7B-instruct-Q4_K_M
RAG_SUMMARY_TIMEOUT=60
RAG_PARSER=pypdf
RAG_MAX_UPLOAD_BYTES=25000000
RAG_MAX_MODEL_QUEUE=8
RAG_REQUEST_TIMEOUT=60
RAG_GENERATION_TIMEOUT=300
RAG_JOB_LEASE_SECONDS=120
RAG_MAX_JOB_ATTEMPTS=3
# Parser runs in a killable subprocess; hung OCR cannot renew a lease forever.
RAG_PARSER_TIMEOUT=300
RAG_WORKER_RETRY_MAX_SECONDS=30
